    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktat muss System Events steuern, um die Transkription mit der AppleScript-Einfügemethode einzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Diktat needs to control System Events to paste your transcription with the AppleScript paste method."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktat 需要控制 System Events，以便通过 AppleScript 粘贴方式插入转录文本。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktat doit contrôler System Events pour coller la transcription avec la méthode de collage AppleScript."
          }
        }
      }
